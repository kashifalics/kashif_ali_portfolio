# Public site URL, used for canonical URLs, the sitemap and Open Graph.
# Leave empty on Vercel to use the deployment's own domain automatically;
# set it once a custom domain is connected, e.g. https://kashifali.dev
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (server-only, never exposed to the browser).
# The form sends through Resend (https://resend.com). Without RESEND_API_KEY the
# form reports that delivery is not configured and offers the email link instead.
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to the email in src/data/profile.ts.
CONTACT_TO_EMAIL=
# Verified Resend sender. "onboarding@resend.dev" works for testing; it can only
# deliver to the address that owns the Resend account.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
